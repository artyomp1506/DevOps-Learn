# ===== Sensitives Configuration =====
# Скопируйте этот файл в application-secrets.properties и заполните значения.
# НЕ коммитьте application-secrets.properties в Git!

# Database
spring.datasource.password=${DB_PASSWORD:change_me}

# JWT
jwt.access-secret=${JWT_ACCESS_SECRET:change_me}
jwt.refresh-secret=${JWT_REFRESH_SECRET:change_me}

# Redis
redis.password=${REDIS_PASSWORD:}

# Cloudflare
cf.token=${CF_TOKEN:}

# Yandex Cloud
cloud.subnet_id=${YC_SUBNET_ID:}

# SSH key
key_path=${KEY_PATH:~/.ssh/id_rsa}

# VM IP (for checking)
vm_ip=${VM_IP:localhost}